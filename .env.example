# Copy to .env at the repository root. All database URLs are server-only.
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=
INGESTION_DATABASE_URL=
MIGRATION_DATABASE_URL=
CORS_ORIGINS=["http://localhost:3000"]
SCRAPER_USER_AGENT=Vantage-development
MAX_CONCURRENT_REQUESTS=3
# CI only: an isolated disposable PostgreSQL database, never your hosted project.
TEST_DATABASE_URL=

# Supabase platform settings. These do not replace the PostgreSQL URLs above.
# The current foundation uses PostgreSQL directly; SDK/auth settings are optional.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose this through NEXT_PUBLIC_* variables.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=${SUPABASE_URL}/auth/v1/.well-known/jwks.json
